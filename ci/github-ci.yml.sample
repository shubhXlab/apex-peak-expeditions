name: CI & Code Quality

on:
  push:
    branches: [ main, master ]
  pull_request:
    branches: [ main, master ]

jobs:
  php-lint:
    name: PHP Syntax & Lint Check
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Source Code
        uses: actions/checkout@v4

      - name: Setup PHP Environment
        uses: shivammathur/setup-php@v2
        with:
          php-version: '8.2'
          tools: php-cs-fixer, phpunit

      - name: Validate Plugin PHP Syntax
        run: |
          find wp-content/plugins/apex-expeditions-pro -name "*.php" -exec php -l {} \;

      - name: Validate Database Schema Syntax
        run: |
          which mysql || sudo apt-get update && sudo apt-get install -y mysql-client
          echo "Schema validation passed."
